<根>
	<命令>
		<名称>模板</名称>
		<平台>windows</平台>
		<模板>test {文本框} {路径} {开关} {选项}</模板>
		<描述>既是测试文件，也是模板文件</描述>
	</命令>
	<参数组>
		<参数 名称="文本框">
			<多参数>true</多参数>
			<绑定设置>true</绑定设置>
			<必需>true</必需>
		</参数>
		<参数 名称="路径" 类型="路径">
		</参数>
		<参数 名称="开关" 类型="开关">
			<默认值>true</默认值>
		</参数>
		<参数 名称="选项" 类型="选项">
			<选项 名称="选项1" 值="-1"/>
			<选项 名称="选项2" 值="-2"/>
			<选项 名称="选项3" 值="-3"/>
			<默认值>选项3</默认值>
		</参数>
	</参数组>
</根>